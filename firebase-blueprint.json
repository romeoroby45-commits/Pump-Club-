{
  "entities": {
    "GymSettings": {
      "title": "GymSettings",
      "description": "General gym branding, contacts, social links, and display copy",
      "type": "object",
      "properties": {
        "gymName": {
          "type": "string",
          "description": "The official brand name of the gym",
          "maxLength": 100
        },
        "gymTagline": {
          "type": "string",
          "description": "Short slogan or tagline for the gym",
          "maxLength": 150
        },
        "welcomeTitle": {
          "type": "string",
          "description": "Welcome headline in hero section",
          "maxLength": 100
        },
        "welcomeText": {
          "type": "string",
          "description": "Main descriptive text welcoming athletes",
          "maxLength": 1000
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Official WhatsApp phone number for inquiries and subscriptions",
          "maxLength": 30
        },
        "instagramUrl": {
          "type": "string",
          "description": "Official Instagram profile link",
          "maxLength": 300
        },
        "locationUrl": {
          "type": "string",
          "description": "Google Maps location link",
          "maxLength": 300
        },
        "locationButtonText": {
          "type": "string",
          "description": "Label for the location action button",
          "maxLength": 100
        },
        "tickerText": {
          "type": "string",
          "description": "Marquee announcement bar moving text",
          "maxLength": 1000
        },
        "logoUrl": {
          "type": "string",
          "description": "Brand logo image URL",
          "maxLength": 500
        },
        "heroBadgeText": {
          "type": "string",
          "description": "Badge text displayed above hero headline",
          "maxLength": 100
        },
        "ctaButtonText": {
          "type": "string",
          "description": "Primary call to action button label",
          "maxLength": 100
        },
        "heroAnimatedBgUrl": {
          "type": "string",
          "description": "URL for hero background image, GIF, or video",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": [
        "gymName",
        "gymTagline",
        "whatsappNumber",
        "locationUrl"
      ]
    },
    "GymPhoto": {
      "title": "GymPhoto",
      "description": "A gallery image showcasing gym facilities, machinery, and athletes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the photo",
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "description": "Direct image URL or Firebase Storage URL",
          "maxLength": 1000
        },
        "title": {
          "type": "string",
          "description": "Optional title or caption for the photo",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": [
        "id",
        "url"
      ]
    },
    "GymReel": {
      "title": "GymReel",
      "description": "A short video or reel showcasing exercises, trainers, or gym vibes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the reel",
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "description": "Direct video URL or YouTube embed URL",
          "maxLength": 1000
        },
        "title": {
          "type": "string",
          "description": "Optional title or caption for the reel",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": [
        "id",
        "url"
      ]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "A membership pricing plan with features, duration, and price",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the plan",
          "maxLength": 128
        },
        "duration": {
          "type": "string",
          "description": "Duration label (e.g. 1 Month, 3 Months, 1 Year)",
          "maxLength": 100
        },
        "price": {
          "type": "number",
          "description": "Price in Egyptian Pounds (EGP)"
        },
        "currency": {
          "type": "string",
          "description": "Currency code, defaults to EGP",
          "maxLength": 10
        },
        "badge": {
          "type": "string",
          "description": "Optional highlight badge label",
          "maxLength": 50
        },
        "isPopular": {
          "type": "boolean",
          "description": "Whether this plan is featured as most popular"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": [
        "id",
        "duration",
        "price",
        "order"
      ]
    },
    "SubscriptionLead": {
      "title": "SubscriptionLead",
      "description": "Customer inquiry submitted through the subscription form",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the lead",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "Customer's full name",
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "description": "Customer's contact phone number",
          "maxLength": 30
        },
        "country": {
          "type": "string",
          "description": "Country name",
          "maxLength": 50
        },
        "countryCode": {
          "type": "string",
          "description": "Dial country code",
          "maxLength": 10
        },
        "subscriptionDuration": {
          "type": "string",
          "description": "Selected plan duration",
          "maxLength": 100
        },
        "price": {
          "type": "number",
          "description": "Selected plan price"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Chosen payment method (Vodafone Cash or InstaPay)",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": [
        "id",
        "fullName",
        "phoneNumber"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "GymSettings",
      "description": "Global gym settings documents, primary doc is 'general'"
    },
    "/photos/{photoId}": {
      "schema": "GymPhoto",
      "description": "Gym photos uploaded or linked by the administrator"
    },
    "/reels/{reelId}": {
      "schema": "GymReel",
      "description": "Gym videos and reels uploaded or linked by the administrator"
    },
    "/plans/{planId}": {
      "schema": "SubscriptionPlan",
      "description": "Gym membership subscription plans"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "SubscriptionLead",
      "description": "Customer membership inquiries and subscription requests"
    }
  }
}
